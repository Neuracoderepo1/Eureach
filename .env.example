NODE_ENV=production
PORT=8080
DATABASE_URL=postgresql://eureach_app:change-me@postgres:5432/eureach
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
DB_POOL_MAX=20
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
CORS_ORIGINS=https://app.example.com
ENABLE_METRICS=false
METRICS_TOKEN=replace-with-a-random-metrics-token-at-least-32-characters
SEED_TENANT_SLUG=demo
SEED_TENANT_NAME=Eureach Demo
SEED_INDUSTRY=agriculture
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
